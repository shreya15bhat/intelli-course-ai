# CourseMind AI Environment Configuration
FLASK_SECRET_KEY=replace-with-a-long-random-secret-key-for-session-cookies
DATABASE_URL=sqlite:///intelli_course.db

# Google Gemini AI Configuration
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# Set DEMO_MODE=true to run offline without calling the Gemini API
DEMO_MODE=false

# YouTube Data API v3 Configuration
# Get your key at: https://console.cloud.google.com/apis/credentials (Enable YouTube Data API v3)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_MAX_RESULTS=5
